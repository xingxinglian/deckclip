# Public site URL (magic links, Stripe redirects)
APP_URL=http://localhost:3000

# Optional: sign cookies more strongly (random 32+ chars)
# AUTH_SECRET=

# Optional: send magic-link email. If unset, the link is printed
# in the server log and returned in the API response (dev-friendly).
# RESEND_API_KEY=
# EMAIL_FROM=DeckClip <hello@example.com>

# Optional: Stripe Checkout for Pro. If unset, pricing uses a
# working test-mode stub / demo checkout page.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=

# Pipeline binaries (defaults work on most Linux/macOS boxes)
# FFMPEG=ffmpeg
# PDFTOTXT=pdftotext
# PDFTOPPM=pdftoppm
